rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------------------------------------------
    // guests/{guestId}
    // - Đọc: công khai (khách cần đọc doc của chính họ qua link cá nhân
    //   để tự động điền tên; ID là chuỗi ngẫu nhiên nên khó đoán).
    // - Tạo/xóa: chỉ admin (đã đăng nhập).
    // - Cập nhật: khách được phép cập nhật CHÍNH các trường RSVP của
    //   mình một lần (rsvpStatus, numAttending, mealPref, message,
    //   respondedAt), không được đổi tên/số lượng tối đa do admin đặt.
    //   Admin (đã đăng nhập) được cập nhật toàn bộ.
    // ----------------------------------------------------------------
    match /guests/{guestId} {
      allow read: if true;

      allow create, delete: if request.auth != null;

      allow update: if request.auth != null
        || (
          // Khách chưa đăng nhập chỉ được sửa các trường RSVP
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['rsvpStatus', 'numAttending', 'mealPref', 'message', 'respondedAt'])
          && request.resource.data.name == resource.data.name
          && request.resource.data.maxGuests == resource.data.maxGuests
          && request.resource.data.numAttending is int
          && request.resource.data.numAttending <= resource.data.maxGuests
          && request.resource.data.rsvpStatus in ['yes', 'no']
          && (request.resource.data.message == null
              || request.resource.data.message.size() <= 300)
        );
    }

    // ----------------------------------------------------------------
    // guestbook/{messageId}
    // - Đọc: công khai.
    // - Tạo: công khai, nhưng bắt buộc đúng cấu trúc & giới hạn độ dài
    //   để hạn chế spam/nội dung rác. Không cho set "approved" tùy ý.
    // - Sửa/xóa: chỉ admin (kiểm duyệt).
    // ----------------------------------------------------------------
    match /guestbook/{messageId} {
      allow read: if true;

      allow create: if
        request.resource.data.keys().hasOnly(['name', 'message', 'createdAt', 'approved'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 280
        && request.resource.data.approved == true;

      allow update, delete: if request.auth != null;
    }

    // ----------------------------------------------------------------
    // Mặc định: chặn tất cả những gì không khai báo ở trên.
    // ----------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
